# Copy this file to `.env` and adjust the values if needed: `cp .env.example .env`

# PostgreSQL connection string. Matches the `db` service in docker-compose.yml.
DATABASE_URL="postgresql://patelin:patelin@localhost:5432/patelin"

# Server log level: trace, debug, info, warn, error or fatal. Defaults to debug in
# development and info in production.
# LOG_LEVEL="info"

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me"
# Public URL of the app (used for OAuth callbacks): http://localhost:3000 in development.
BETTER_AUTH_URL="http://localhost:3000"

# OAuth apps. A provider shows up on the sign-in page only when both values are set.
# Google: https://console.cloud.google.com/apis/credentials
#   redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Discord: https://discord.com/developers/applications
#   redirect URI: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Email + password sign-in for local development and end-to-end tests only.
# Never "true" in production.
AUTH_DEV_LOGIN="true"
