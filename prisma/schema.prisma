// Prisma schema for Patelin. The connection URL lives in prisma.config.ts.
// Accounts arrive in phase 2, cards in phase 3.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Rarity tiers, from the most common to the rarest (thresholds in lib/tiers.ts).
enum Tier {
  COMMUNE
  PEU_COMMUNE
  RARE
  EPIQUE
  LEGENDAIRE
  MYTHIQUE
}

model Region {
  code        String       @id
  name        String
  // INSEE code of the regional capital.
  chefLieu    String
  departments Department[]
  communes    Commune[]
}

model Department {
  code       String    @id
  name       String
  regionCode String
  region     Region    @relation(fields: [regionCode], references: [code])
  // INSEE code of the prefecture.
  chefLieu   String
  communes   Commune[]

  @@index([regionCode])
}

model Commune {
  inseeCode      String     @id
  name           String
  // Lowercase, accent-free name for the collection search (lib/search.ts): "Bœurs" → "boeurs".
  searchName     String
  departmentCode String
  department     Department @relation(fields: [departmentCode], references: [code])
  regionCode     String
  region         Region     @relation(fields: [regionCode], references: [code])
  population     Int
  surfaceHa      Float
  latitude       Float
  longitude      Float
  // Equivalent radius √(surface / π) in km, floored at 1.5 km: the unit of placement tiers.
  radiusKm       Float
  tier           Tier
  // False once a commune disappears from the INSEE list (merged into another one).
  // Its cards stay valid; it just leaves the draw.
  isActive       Boolean    @default(true)

  // Photo from Wikimedia Commons (via Wikidata P18), served through next/image.
  photoFile       String?
  photoThumbUrl   String?
  photoAuthor     String?
  photoLicense    String?
  photoLicenseUrl String?

  // Wikimedia Commons category of the commune (Wikidata P373), where postcards are looked up.
  commonsCategory String?

  // Public-domain old postcard, used by the rare "carte postale ancienne" variant.
  postcardFile      String?
  postcardThumbUrl  String?
  postcardAuthor    String?
  postcardLicense   String?
  // When data:postcards last looked for a postcard, so that an interrupted run can resume.
  postcardCheckedAt DateTime?

  setMembers    SetMember[]
  cardStacks    CardStack[]
  cardInstances CardInstance[]
  updatedAt     DateTime       @updatedAt

  @@index([departmentCode])
  @@index([regionCode])
  @@index([tier])
  @@index([name])
}

enum SetType {
  DEPARTMENT
  REGION
  PREFECTURES
  HOMONYMS
}

model CardSet {
  slug    String      @id
  type    SetType
  name    String
  members SetMember[]

  @@index([type])
}

model SetMember {
  setSlug   String
  set       CardSet @relation(fields: [setSlug], references: [slug], onDelete: Cascade)
  inseeCode String
  commune   Commune @relation(fields: [inseeCode], references: [inseeCode])

  @@id([setSlug, inseeCode])
  @@index([inseeCode])
}

// ---------------------------------------------------------------------------
// Accounts (phase 2). User, Session, Account and Verification follow the shape
// Better Auth expects; pseudo and boostersOpened are Patelin's own fields.

model User {
  id             String    @id
  // Name and email come from Google or Discord and stay private; other players see the pseudo.
  name           String
  email          String    @unique
  emailVerified  Boolean   @default(false)
  image          String?
  // Public name, chosen after the first sign-in. Null until then.
  pseudo         String?
  // Lowercase, accent-free form of the pseudo: two pseudos differing only by case or accents clash.
  pseudoKey      String?   @unique
  boostersOpened Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sessions       Session[]
  accounts       Account[]

  // Free booster stock, computed on the fly (lib/free-boosters.ts). Null means a full stock.
  freeBoostersFrom DateTime?
  boosters         Booster[]
  cardStacks       CardStack[]
  cardInstances    CardInstance[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Boosters and cards (phase 3).

enum BoosterKind {
  // Taken from the free stock, which refills over time.
  FREE
  // Given at the first visit of the day.
  DAILY
  // Cards of the department of the day only.
  DEPARTMENT
}

model Booster {
  id             String         @id @default(uuid(7))
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           BoosterKind
  // Department a DEPARTMENT booster draws from.
  departmentCode String?
  // Paris calendar day of a DAILY or DEPARTMENT booster: one of each per player and per day.
  // Null for FREE boosters, which the unique index below then leaves alone.
  day            DateTime?      @db.Date
  createdAt      DateTime       @default(now())
  // Set once, by the transaction that opens the booster.
  openedAt       DateTime?
  // INSEE codes drawn at opening, in reveal order: the guaranteed Rare-or-better card comes last.
  communeCodes   String[]       @default([])
  // Positions in communeCodes of the cards that were the player's first of their commune.
  newPositions   Int[]          @default([])
  cardInstances  CardInstance[]

  @@unique([userId, kind, day])
  @@index([userId, openedAt])
}

// Normal cards are interchangeable: one row per player and commune holds how many they have.
// The row is created by the first card of a commune the player receives, whatever its kind, and
// stays when count drops to 0: its existence means "this commune is no longer new to them".
model CardStack {
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  inseeCode       String
  commune         Commune  @relation(fields: [inseeCode], references: [inseeCode])
  // Never negative (CHECK constraint in the migration).
  count           Int
  firstObtainedAt DateTime @default(now())

  @@id([userId, inseeCode])
  @@index([inseeCode])
}

enum CardVariant {
  // An old public-domain postcard in place of the photo.
  POSTCARD
}

// A unique copy: a variant today, a decorated card from phase 4. It has one owner at a time.
model CardInstance {
  id         String       @id @default(uuid(7))
  ownerId    String
  owner      User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  inseeCode  String
  commune    Commune      @relation(fields: [inseeCode], references: [inseeCode])
  variant    CardVariant?
  // Tier of the commune when the card was drawn: a later INSEE update does not change it.
  tier       Tier
  boosterId  String?
  booster    Booster?     @relation(fields: [boosterId], references: [id], onDelete: SetNull)
  obtainedAt DateTime     @default(now())

  @@index([ownerId, inseeCode])
  @@index([inseeCode])
}
